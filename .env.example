# Copy to .env and adjust. Everything is optional: the default mode is fully offline.
# (Export these variables in your shell, or use a tool such as direnv / python-dotenv.)

# Where reports and agent actions (tickets, alerts, review queue) are written
IDP_OUTPUT_DIR=output

# "none" = deterministic rule-based agent (default) | "anthropic" = LLM chooses the actions
IDP_LLM_PROVIDER=none
IDP_LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# Agent behaviour
IDP_MAX_RETRIES=3
IDP_RETRY_BACKOFF=0.5
IDP_MIN_CONFIDENCE=0.6

# OCR (Tesseract language codes, '+' to combine)
IDP_OCR_LANG=eng+fra

# API upload limit
IDP_MAX_UPLOAD_MB=10
